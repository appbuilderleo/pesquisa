# ==============================================================================
# PESQUISA STOKA — EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este ficheiro para .env ou .env.local e preencha com os seus valores.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (CockroachDB / PostgreSQL)
# As tabelas da aplicação e as tabelas de autenticação (users) residem nesta base.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://pesquisa:<SENHA>@pesquisa-20639.jxf.gcp-europe-west2.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# Parâmetros individuais do banco de dados (alternativa ao DATABASE_URL):
DB_HOST="pesquisa-20639.jxf.gcp-europe-west2.cockroachlabs.cloud"
DB_PORT="26257"
DB_NAME="defaultdb"
DB_USER="pesquisa"
DB_PASSWORD="<SENHA>"
DB_SSL="true"

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO E SESSÃO
# Os usuários são salvos na tabela 'users' no CockroachDB (senhas em hash bcrypt).
# As sessões são assinadas via JWT e guardadas em cookies HTTP-Only protegidos.
# ------------------------------------------------------------------------------
JWT_SECRET="stoka-pesquisa-secret-key-2025-token-random-key"
COOKIE_NAME="stoka_session"

# ------------------------------------------------------------------------------
# 3. CONTA ADMINISTRADOR PADRÃO (Semeada na tabela 'users' do banco de dados)
# ------------------------------------------------------------------------------
ADMIN_NAME="Administrador STOKA"
ADMIN_EMAIL="admin@stoka.mz"
ADMIN_PASSWORD="adminstoka2025"

# ------------------------------------------------------------------------------
# 4. APLICAÇÃO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Pesquisa Stoka"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
